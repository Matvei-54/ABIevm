# Docker Compose reads .env. The Go process does NOT load it automatically:
# set DATABASE_URL and RPC variables in the terminal or IDE Run Configuration.
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432
DATABASE_URL=postgres://abievm:change_me_local@127.0.0.1:5432/abievm?sslmode=disable
# Set your Ethereum Mainnet endpoint, without committing a private key.
STAKEDAO_ETHEREUM_RPC_URL=
RPC_MAX_RPS=18
STAKEDAO_DISCOVERY_WORKERS=8
