# Existing local PostgreSQL; replace username/password/database with your values.
# Go does NOT load .env automatically: set these in the terminal or IDE Run Configuration.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/abievm?sslmode=disable
# Set your Ethereum Mainnet endpoint, without committing a private key.
STAKEDAO_ETHEREUM_RPC_URL=
RPC_MAX_RPS=18
STAKEDAO_DISCOVERY_WORKERS=8

# Optional Docker Compose settings only; not required by Go or an installed Postgres.
# POSTGRES_PASSWORD=change_me_local
# POSTGRES_PORT=5432
