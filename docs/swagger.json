        "/reservesStakedao/{network}": {
            "get": {
                "description": "По умолчанию: name, apr, symbol, address (vault), apy, status (полнота APR). APR относится к vault_rewards: CRV и активным выплатам RewardVault. APY — торговая доходность за 30 дней для проверенных fixed-rate Curve-пулов, требуется историческое состояние RPC. details=true добавляет state и yieldBreakdown с окнами 7/30 дней, источниками, блоками и причинами недоступности. Gauge-проекция не прибавляется к APR. Merkl пока недоступен.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "StakeDao"
                ],
                "summary": "Получить пулы StakeDAO из блокчейна",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Поддерживаемая сеть: ethereum",
                        "name": "network",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "Полный ответ с контрактами, TVL и диагностикой",
                        "name": "details",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.StakeDAOPoolsSummaryResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/reservesStakedao/{network}/diagnostics": {
            "get": {
                "description": "Стандартные 2/5 пулов или произвольные 1–5 gauge, без истории регистраций и Postgres. Состав APR, цены, торговая APY поддержанных моделей, маршрут наград BOLD. weethFeeDays отдельно включает скан swaps и оценку fee APR только для weETH/WETH. Не более 5 RPC/с и 300 попыток.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "StakeDao"
                ],
                "summary": "Диагностика выбранных пулов StakeDAO",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Поддерживаемая сеть: ethereum",
                        "name": "network",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            2,
                            5
                        ],
                        "type": "integer",
                        "default": 2,
                        "description": "Количество контрольных пулов",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "1–5 gauge через запятую; при указании limit не используется",
                        "name": "gauges",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Десятичный номер блока; включает строгие цены этого блока",
                        "name": "block",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "default": false,
                        "description": "Изолированные цены выбранного блока без общего кэша",
                        "name": "strictPrices",
                        "in": "query"
                    },
                    {
                        "enum": [
                            1,
                            7,
                            30
                        ],
                        "type": "integer",
                        "description": "Оценка fee APR по swaps за 1/7/30 дней; только один weETH/WETH gauge. Не APY; использует параметры конечного блока",
                        "name": "weethFeeDays",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.StakeDAOPoolsResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/reservesStakedao/{network}/state": {
            "get": {
                "description": "1–5 gauge: регистрация, shutdown, pause, is_killed, активы и вес CRV на одном блоке. Возвращает также shutdown и незарегистрированные gauge. Без цен, APR, истории и Postgres. Не более 5 RPC/с и 300 попыток. Null означает неизвестное или неприменимое значение; ошибки полей — в state.issues.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "StakeDao"
                ],
                "summary": "Проверить состояние gauge StakeDAO отдельно от доходности",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Поддерживаемая сеть: ethereum",
                        "name": "network",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "1–5 gauge через запятую",
                        "name": "gauges",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Положительный десятичный номер блока; по умолчанию latest",
                        "name": "block",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.StakeDAOPoolStatesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
